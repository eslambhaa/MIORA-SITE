{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site only: no Worker script, Cloudflare serves the Vite build from dist/.
  "name": "miora",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    // React Router handles every page in the browser, so unknown paths get index.html.
    "not_found_handling": "single-page-application"
  }
}
